---
interface Props {
	/** Leave `href` out for a page that isn't written yet: it shows as "coming soon" instead of a broken link. */
	topics: { label: string; href?: string; description: string }[];
}

const { topics } = Astro.props;
// A navigation landmark with no links is noise for screen readers: use a plain section until a topic is published.
const Wrapper = topics.some((topic) => topic.href) ? 'nav' : 'section';
---

<Wrapper class="next-topics" aria-label="Where to go next">
	<ul>
		{
			topics.map((topic) => (
				<li>
					{topic.href ? (
						<a href={topic.href}>{topic.label}</a>
					) : (
						<span class="upcoming">
							{topic.label} <span class="soon">(coming soon)</span>
						</span>
					)}
					<span class="description">{topic.description}</span>
				</li>
			))
		}
	</ul>
</Wrapper>

<style>
	.next-topics {
		margin-block: 1rem 1rem;
	}

	ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	li {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0 0.75rem;
		padding-block: 0.4rem;
	}

	a {
		color: var(--ms-ink);
		font-weight: 600;
		text-decoration: underline;
		text-decoration-color: var(--ms-ink-muted);
		text-underline-offset: 0.18em;
	}

	a:hover {
		text-decoration-color: var(--ms-ink);
	}

	.upcoming {
		font-weight: 600;
		color: var(--ms-ink);
	}

	.soon {
		font-weight: 400;
		color: var(--ms-ink-muted);
	}

	.description {
		color: var(--ms-ink-muted);
	}
</style>
