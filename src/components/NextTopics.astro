---
interface Props {
	topics: { label: string; href: string; description: string }[];
}

const { topics } = Astro.props;
---

<nav class="next-topics" aria-label="Up next">
	<p class="label">Up next</p>
	<ul>
		{
			topics.map((topic) => (
				<li>
					<a href={topic.href}>{topic.label}</a>
					<span class="description">{topic.description}</span>
				</li>
			))
		}
	</ul>
</nav>

<style>
	.next-topics {
		margin-block: 2.5rem 1rem;
	}

	.label {
		margin: 0 0 0.5rem;
		font-family: var(--ms-font-ui);
		font-size: 0.9375rem;
		font-weight: 600;
		color: var(--ms-ink);
	}

	ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	li {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0 0.75rem;
		padding-block: 0.4rem;
	}

	a {
		color: var(--ms-ink);
		font-weight: 600;
		text-decoration: underline;
		text-decoration-color: var(--ms-ink-muted);
		text-underline-offset: 0.18em;
	}

	a:hover {
		text-decoration-color: var(--ms-ink);
	}

	.description {
		color: var(--ms-ink-muted);
	}
</style>
