---
// A derivation as numbered steps, each changing one thing (decision 0008). Put a markdown ordered list in the slot.
interface Props {
	/** What is being shown, e.g. "Why the constant is 1/√(2π)". */
	title: string;
	/** "sketch" skips routine algebra; "full" shows every step. */
	rigor?: 'sketch' | 'full';
}

const { title, rigor = 'sketch' } = Astro.props;
---

<div class="step-through">
	<p><strong>{title}</strong> <span class="rigor">({rigor === 'sketch' ? 'sketch' : 'full proof'})</span></p>
	<slot />
</div>

<style>
	.rigor {
		font-family: var(--ms-font-ui);
		font-size: 0.875rem;
		color: var(--ms-ink-muted);
	}

	.step-through :global(ol) {
		padding-inline-start: 1.5rem;
	}
</style>
