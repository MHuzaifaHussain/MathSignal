---
// The ML relevance of a concept, straight after ConceptHeader.
---

<aside class="why-this-matters" aria-label="Why this matters in machine learning">
	<p class="label">Why this matters in ML</p>
	<div class="body"><slot /></div>
</aside>

<style>
	/* Set apart by its label and spacing, not by a vertical bar (decision 0006) */
	.why-this-matters {
		margin-block: 2rem 2.5rem;
	}

	.label {
		margin: 0 0 0.35rem;
		font-family: var(--ms-font-ui);
		font-size: 0.9375rem;
		font-weight: 600;
		color: var(--ms-ink);
	}

	.body :global(p) {
		margin-block: 0 0.75em;
	}

	.body :global(p:last-child) {
		margin-block-end: 0;
	}
</style>
