---
// The formal math for a concept, closed by default. Use \vmu and \vsigma inside.
---

<details class="formal-definition" id="formal-definition">
	<summary>
		Formal definition, derivations and properties
	</summary>
	<div class="content"><slot /></div>
</details>

<style>
	/* A sunk band: no outline, no rounded corners, no inner rule (decision 0006) */
	.formal-definition {
		margin-block: 2rem;
		padding: 0.25rem 1rem 0.25rem;
		background-color: var(--ms-surface-sunk);
	}

	summary {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 44px;
		font-family: var(--ms-font-ui);
		font-size: 0.9375rem;
		font-weight: 600;
		color: var(--ms-ink);
		cursor: pointer;
	}

	.content {
		padding-block: 0.25rem 1rem;
	}
</style>
