---
// The formal maths for a concept, closed by default. Use \vmu and \vsigma inside.
---

<details class="formal-definition">
	<summary>
		Formal definition
	</summary>
	<div class="content"><slot /></div>
</details>

<style>
	.formal-definition {
		margin-block: 2rem;
		border: 1px solid var(--ms-rule);
		border-radius: 4px;
		background-color: var(--ms-surface-sunk);
	}

	summary {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 44px;
		padding-inline: 1rem;
		font-family: var(--ms-font-ui);
		font-size: 0.9375rem;
		font-weight: 600;
		color: var(--ms-ink);
		cursor: pointer;
	}

	.content {
		padding: 0.25rem 1.25rem 1.25rem;
		border-top: 1px solid var(--ms-rule);
	}
</style>
