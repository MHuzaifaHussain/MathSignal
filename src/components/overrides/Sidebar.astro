---
// Starlight Sidebar override: adds the subject list at the top of the mobile menu, because the
// header strip is hidden on narrow screens. The sidebar itself is Starlight's own; it is narrowed
// to the active subject by the route middleware in src/routeData.ts.
import DefaultSidebar from '@astrojs/starlight/components/Sidebar.astro';
import DomainNav from './DomainNav.astro';
---

<div class="mobile-domains"><DomainNav variant="stacked" /></div>

<DefaultSidebar />

<style>
	/* Same breakpoint as the header strip: below it, subjects live here */
	@media (min-width: 72rem) {
		.mobile-domains {
			display: none;
		}
	}
</style>
