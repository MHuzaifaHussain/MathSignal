---
// A list of misconceptions. Children are <Mistake> items.
---

<aside class="common-mistakes" aria-label="Common mistakes">
	<p class="label">Common mistakes</p>
	<ul><slot /></ul>
</aside>

<style>
	.common-mistakes {
		margin-block: 2.5rem;
	}

	.label {
		margin: 0 0 0.75rem;
		font-family: var(--ms-font-ui);
		font-size: 0.9375rem;
		font-weight: 600;
		color: var(--ms-ink);
	}

	ul {
		margin: 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--ms-rule);
	}
</style>
