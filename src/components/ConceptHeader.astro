---
// Opens every concept page: the definition in one sentence, the level, what to know first (with a short
// recap of each prerequisite from src/data/topics.mjs), what the page teaches, and a skip line for experts.
import { getTopic, topicHref } from '../data/topics.mjs';
import { FORMAL_DEFINITION_ID, PRECISE_STATEMENT_ID } from './sectionAnchors';

const RESEARCH_FRONTIER_SLUG = 'research-frontier';
const REFERENCES_SLUG = 'references';
// Opening tags only, so an import line alone doesn't count as the section being on the page.
const PRECISE_STATEMENT_TAG = /<PreciseStatement[\s/>]/;
const FORMAL_DEFINITION_TAG = /<FormalDefinition[\s/>]/;

const DIFFICULTY_LABELS = {
	beginner: 'Beginner',
	intermediate: 'Intermediate',
	advanced: 'Advanced',
} as const;

interface Props {
	/** One sentence that names and defines the concept: "The normal distribution is …". */
	oneLiner: string;
	difficulty: keyof typeof DIFFICULTY_LABELS;
}

const { oneLiner, difficulty } = Astro.props;
const { entry, headings } = Astro.locals.starlightRoute;
const { topic: topicId, objectives = [] } = entry.data;
if (typeof entry.body !== 'string') {
	throw new Error(`<ConceptHeader>: no MDX source for "${entry.id}", so the skip line can't tell which sections exist.`);
}
const pageSource = entry.body;
const prerequisites = topicId ? getTopic(topicId).prerequisites.map(getTopic) : [];

// The skip line links a section only when its anchor is on the page, which is what scripts/check-links.mjs checks.
// The research frontier and references anchors are heading slugs (C, D and F pages, and spine-depth pages, have no
// frontier). The precise statement and derivations anchors are ids on their components, which render after this
// header, so the page source tells whether they are used.
const hasHeading = (slug: string) => headings.some((heading) => heading.slug === slug);
const skipLinks = [
	{ label: 'precise statement', id: PRECISE_STATEMENT_ID, isOnPage: PRECISE_STATEMENT_TAG.test(pageSource) },
	{ label: 'derivations', id: FORMAL_DEFINITION_ID, isOnPage: FORMAL_DEFINITION_TAG.test(pageSource) },
	{ label: 'research frontier', id: RESEARCH_FRONTIER_SLUG, isOnPage: hasHeading(RESEARCH_FRONTIER_SLUG) },
	{ label: 'references', id: REFERENCES_SLUG, isOnPage: hasHeading(REFERENCES_SLUG) },
].filter((link) => link.isOnPage);

/** "the X", "the X or the Y", "the X, the Y or the Z": the text before the link at `index`. */
const separatorBefore = (index: number, count: number) => {
	if (index === 0) return '';
	return index === count - 1 ? ' or ' : ', ';
};
---

<div class="not-content concept-header">
	<p class="one-liner">{oneLiner}</p>
	<p class="meta">Level: {DIFFICULTY_LABELS[difficulty]}</p>

	{
		prerequisites.length > 0 && (
			<div class="block">
				<p class="ms-ui-label">Before you start</p>
				<ul class="prerequisites">
					{prerequisites.map((prerequisite) => {
						const href = topicHref(prerequisite);
						return (
							<li>
								{href ? <a href={href}>{prerequisite.title}</a> : <span class="title">{prerequisite.title}</span>}
								<span class="recap">{prerequisite.recap}</span>
							</li>
						);
					})}
				</ul>
			</div>
		)
	}

	{
		objectives.length > 0 && (
			<div class="block">
				<p class="ms-ui-label">On this page you will</p>
				<ul class="objectives">
					{objectives.map((objective) => (
						<li>{objective}</li>
					))}
				</ul>
			</div>
		)
	}

	{
		skipLinks.length > 0 && (
			<p class="skip-line">
				Know the basics already? Jump to{' '}
				{skipLinks.map((link, index) => (
					<>
						{`${separatorBefore(index, skipLinks.length)}the `}
						<a href={`#${link.id}`}>{link.label}</a>
					</>
				))}
				.
			</p>
		)
	}
</div>

<style>
	.concept-header {
		margin-block-end: 2rem;
	}

	.one-liner {
		margin: 0;
		max-inline-size: 60ch;
		font-family: var(--ms-font-serif);
		font-size: 1.2rem;
		line-height: 1.55;
		color: var(--ms-ink);
	}

	.meta {
		margin: 0.75rem 0 0;
		font-family: var(--ms-font-ui);
		font-size: 0.9375rem;
		color: var(--ms-ink-muted);
	}

	.block {
		margin-block-start: 1.25rem;
		max-inline-size: 66ch;
	}

	ul {
		margin: 0.35rem 0 0;
		padding-inline-start: 1.25rem;
		font-family: var(--ms-font-serif);
		font-size: 1rem;
		line-height: 1.55;
		color: var(--ms-ink);
	}

	.prerequisites {
		list-style: none;
		padding-inline-start: 0;
	}

	.prerequisites li {
		margin-block-end: 0.5rem;
	}

	.prerequisites a,
	.prerequisites .title {
		font-weight: 600;
		color: var(--ms-ink);
	}

	.recap {
		display: block;
		color: var(--ms-ink-muted);
	}

	a {
		color: var(--ms-ink);
		text-decoration: underline;
		text-decoration-color: var(--ms-ink-muted);
		text-underline-offset: 0.18em;
	}

	.skip-line {
		margin: 1.25rem 0 0;
		font-family: var(--ms-font-ui);
		font-size: 0.9375rem;
		line-height: 1.6;
		color: var(--ms-ink-muted);
	}
</style>
