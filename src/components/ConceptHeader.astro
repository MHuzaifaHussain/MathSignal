---
interface Props {
	/** One sentence saying what the concept is. */
	oneLiner: string;
	difficulty: 'beginner' | 'intermediate' | 'advanced';
	prerequisites?: { label: string; href: string }[];
}

const { oneLiner, difficulty, prerequisites = [] } = Astro.props;
---

<div class="not-content concept-header">
	<p class="one-liner">{oneLiner}</p>
	<p class="meta">
		<span>Level: {difficulty}</span>
		{
			prerequisites.length > 0 && (
				<span>
					Builds on{' '}
					{prerequisites.map((prerequisite, index) => (
						<>
							<a href={prerequisite.href}>{prerequisite.label}</a>
							{index < prerequisites.length - 2 ? ', ' : index === prerequisites.length - 2 ? ' and ' : ''}
						</>
					))}
				</span>
			)
		}
	</p>
</div>

<style>
	.concept-header {
		margin-block-end: 2rem;
	}

	.one-liner {
		margin: 0;
		max-inline-size: 60ch;
		font-family: var(--ms-font-serif);
		font-size: 1.3rem;
		line-height: 1.5;
		color: var(--ms-ink);
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.5rem;
		margin: 0.75rem 0 0;
		font-family: var(--ms-font-ui);
		font-size: 0.9375rem;
		color: var(--ms-ink-muted);
	}

	.meta a {
		color: var(--ms-ink);
		text-decoration: underline;
		text-underline-offset: 0.18em;
	}
</style>
