---
// One retrieval question with its explained answer in a fold. Use at least one per level on a page (decision 0008).
import Fold from './Fold.astro';

const LEVEL_LABELS = {
	intuition: 'Intuition',
	standard: 'Standard',
	proof: 'Proof',
} as const;

interface Props {
	question: string;
	level: keyof typeof LEVEL_LABELS;
}

const { question, level } = Astro.props;
---

<div class="check-yourself">
	<p class="question"><span class="level">{LEVEL_LABELS[level]}</span> {question}</p>
	<Fold kind="answer" label="show the answer and why"><slot /></Fold>
</div>

<style>
	.check-yourself {
		margin-block: 1rem 1.5rem;
	}

	.question {
		margin-block-end: 0.25rem;
	}

	.level {
		font-family: var(--ms-font-ui);
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--ms-ink-muted);
		margin-inline-end: 0.5em;
	}
</style>
